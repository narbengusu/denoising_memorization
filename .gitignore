.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
data/
CLAUDE.md
MISSING_FROM_CLUSTER.md

# large / generated directories (any depth -- covers experiments/*/checkpoints,
# experiments/*/pretrained, etc. too)
preliminary/
figures/
checkpoints/
pretrained/
trained_data/

# cluster job scripts -- contain personal info (usernames, paths, etc.)
*.sh

# generated plots (checkpoints/ already covers most, but stray root-level ones too)
*.png

# workshop paper figures: the generators AND their rendered output are
# deliverables, so they override the blanket *.png / checkpoints rules above.
!workshop_figures/
!workshop_figures/**
# ...except the per-run sample caches and compiled bytecode, regenerable / can be large.
workshop_figures/cache/
workshop_figures/**/__pycache__/
workshop_figures/**/*.pyc
.DS_Store
